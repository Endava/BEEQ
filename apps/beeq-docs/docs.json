{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "BEEQ Design System",
  "description": "BEEQ is a white-label open-source design system created at Endava that accelerates the building of digital products with the goal of providing a UI Library of components and guidelines to help designers and developers produce high-quality solutions.",
  "favicon": "/favicon.svg",
  "variables": {
    "BEEQ_VERSION": "1.17.1"
  },
  "logo": {
    "light": "/logo/beeq-light.svg",
    "dark": "/logo/beeq-dark.svg"
  },
  "fonts": {
    "heading": {
      "family": "Outfit",
      "weight": 700
    },
    "body": {
      "family": "Outfit"
    }
  },
  "icons": {
    "library": "fontawesome"
  },
  "background": {
    "color": {
      "dark": "#0d0e11",
      "light": "#ffffff"
    }
  },
  "colors": {
    "primary": "#4f46e5",
    "light": "#4f46e5",
    "dark": "#4f46e5"
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "dark": "night-owl",
        "light": "one-light"
      }
    }
  },
  "navigation": {
    "$ref": "./config/navigation.json"
  },
  "navbar": {
    "links": [
      {
        "icon": "code",
        "label": "Storybook",
        "href": "https://storybook.beeq.design"
      },
      {
        "icon": "github",
        "label": "GitHub",
        "href": "https://github.com/Endava/BEEQ"
      }
    ]
  },
  "redirects": [
    {
      "source": "/components",
      "destination": "/components/overview"
    }
  ],
  "contextual": {
    "options": [
      "copy",
      "mcp",
      "chatgpt",
      "claude",
      "cursor",
      "devin",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Endava/BEEQ",
      "linkedin": "https://www.linkedin.com/company/endava/",
      "website": "https://www.endava.com"
    }
  }
}
