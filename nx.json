{
  "extends": "nx/presets/npm.json",
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "nxCloudId": "64007df8da9fd31ee8a4d06e",
  "useDaemonProcess": false,
  "cli": {
    "packageManager": "pnpm"
  },
  "workspaceLayout": {
    "appsDir": "apps",
    "libsDir": "packages"
  },
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/tailwind.config.ts"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/jest.config.ts"
    ]
  },
  "targetDefaults": {
    "icons": { "cache": true },
    "stylelint": { "cache": true },
    "prepare-storybook": { "cache": true },
    "check": {
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/biome.json",
        {
          "externalDependencies": ["@biomejs/biome"]
        }
      ]
    },
    "test": {
      "cache": true,
      "inputs": ["default", "^default", "{workspaceRoot}/jest.preset.js"]
    },
    "prebuild": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "e2e": {
      "cache": true,
      "inputs": ["default", "^production"],
      "dependsOn": [{ "target": "build", "projects": "beeq" }]
    },
    "storybook-build": {
      "cache": true,
      "dependsOn": [
        { "target": "prepare-storybook", "projects": "beeq" },
        { "target": "build", "projects": "beeq" },
        { "target": "storybook-build-css", "projects": "beeq" }
      ]
    },
    "storybook-build-css": {
      "cache": true,
      "dependsOn": [{ "target": "build", "projects": "beeq-tailwindcss" }]
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectName}"
      }
    }
  },
  "release": {
    "changelog": {
      "workspaceChangelog": {
        "createRelease": "github",
        "renderOptions": {
          "authors": true,
          "applyUsernameToAuthors": true,
          "commitReferences": true,
          "versionTitleDate": true
        }
      }
    },
    "conventionalCommits": {
      "useCommitScope": false,
      "types": {
        "feat": { "semverBump": "minor", "changelog": { "title": "Features ⚡️" } },
        "fix": { "semverBump": "patch", "changelog": { "title": "Bug Fixes 🐞" } },
        "test": { "semverBump": "patch", "changelog": { "title": "Test 🧪" } },
        "style": { "semverBump": "patch", "changelog": { "title": "Style 🎨" } },
        "chore": { "semverBump": "patch", "changelog": { "title": "Chore ⚙️" } },
        "perf": { "semverBump": "patch", "changelog": { "title": "Performance ⌛️" } },
        "refactor": { "semverBump": "patch", "changelog": { "title": "Refactor 🛠️" } },
        "revert": { "semverBump": "patch", "changelog": { "title": "Revert 🔄" } },
        "docs": false,
        "release": false,
        "ci": false
      }
    },
    "projects": [
      "packages/beeq",
      "packages/beeq-angular",
      "packages/beeq-react",
      "packages/beeq-vue",
      "packages/beeq-tailwindcss"
    ],
    "git": {
      "commit": true,
      "commitMessage": "release: {version} [skip ci]",
      "stageChanges": true,
      "tag": true
    },
    "version": {
      "conventionalCommits": true,
      "versionPrefix": "^"
    },
    "releaseTag": {
      "pattern": "v{version}"
    }
  },
  "generators": {
    "@nx/react": {
      "application": {
        "babel": true
      }
    },
    "@nx/angular:application": {
      "style": "scss",
      "linter": "none",
      "unitTestRunner": "none",
      "e2eTestRunner": "none",
      "prefix": "app",
      "skipTests": true,
      "standaloneConfig": true
    },
    "@nx/angular:library": {
      "linter": "none",
      "unitTestRunner": "none"
    },
    "@nx/angular:component": {
      "style": "scss"
    }
  },
  "pluginsConfig": {
    "@nx/js": {
      "analyzeSourceFiles": true
    }
  },
  "analytics": false,
  "migrate": { "agentic": false }
}
