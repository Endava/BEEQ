{
  "name": "beeq-tailwindcss",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/beeq-tailwindcss/src",
  "projectType": "library",
  "tags": ["publishable", "preset", "tailwindcss"],
  "targets": {
    "generate": {
      "executor": "nx:run-commands",
      "inputs": [
        "{projectRoot}/scripts/**/*",
        "{workspaceRoot}/packages/beeq/src/global/styles/foundations/**/*.scss"
      ],
      "outputs": ["{projectRoot}/src/generated"],
      "options": {
        "command": "pnpm exec tsx scripts/generate-tokens.ts",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec vitest run",
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec biome lint {projectRoot}"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec biome check {projectRoot}"
      }
    }
  }
}
