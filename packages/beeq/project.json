{
  "name": "beeq",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/beeq/src",
  "projectType": "library",
  "tags": ["components", "core", "publishable"],
  "implicitDependencies": ["beeq-tailwindcss"],
  "namedInputs": {
    "production": [
      "default",
      "!{projectRoot}/**/*.mdx",
      "!{projectRoot}/**/*.e2e.ts",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/**/*.stories.tsx",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/jest.config.ts"
    ]
  },
  "targets": {
    "start": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "projects": "beeq-tailwindcss", "target": "build" }],
      "outputs": ["{workspaceRoot}/dist/beeq"],
      "continuous": true,
      "readyWhen": { "logMatches": "build finished, watching for changes..." },
      "inputs": ["default", "{workspaceRoot}/tailwind.config.ts", "{workspaceRoot}/postcss.config.js"],
      "options": {
        "command": "node tools/scripts/stencil-build.mjs --dev --watch --serve --no-open --docs"
      }
    },
    "storybook": {
      "dependsOn": [
        { "target": "start", "waitFor": "ready" },
        { "target": "prepare-storybook" },
        { "target": "storybook-start-css", "waitFor": "ready" }
      ],
      "options": {
        "loglevel": "error",
        "port": 9001,
        "host": "127.0.0.1",
        "config-dir": ".storybook"
      },
      "configurations": {
        "ci": {
          "args": ["--quiet"]
        }
      }
    },
    "build": {
      "dependsOn": ["^build", { "target": "icons" }],
      "executor": "nx:run-commands",
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/tailwind.config.ts",
        "{workspaceRoot}/postcss.config.js"
      ],
      "outputs": [
        "{workspaceRoot}/dist/beeq",
        "{projectRoot}/.storybook/custom-elements.json",
        "{workspaceRoot}/packages/beeq-angular/src/directives",
        "{workspaceRoot}/packages/beeq-angular/standalone/src/directives",
        "{workspaceRoot}/packages/beeq-react/src/components.ts",
        "{workspaceRoot}/packages/beeq-react/ssr/components.ts",
        "{workspaceRoot}/packages/beeq-react/ssr/components.server.ts",
        "{workspaceRoot}/packages/beeq-vue/src/components.ts",
        "{workspaceRoot}/packages/beeq-vue/src/vue-component-lib"
      ],
      "options": {
        "command": "node tools/scripts/stencil-build.mjs --docs"
      },
      "configurations": {
        "production": {
          "command": "node tools/scripts/stencil-build.mjs --prod --docs"
        }
      }
    },
    "build-styles": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/beeq/dist/beeq/css/tokens.css",
        "{workspaceRoot}/dist/beeq/dist/beeq/css/reset.css",
        "{workspaceRoot}/dist/beeq/dist/beeq/css/typography.css"
      ],
      "options": {
        "command": "node packages/beeq/scripts/build-styles.mjs"
      }
    },
    "storybook-build": {
      "outputs": ["{workspaceRoot}/dist/storybook/beeq"],
      "options": {
        "stats-json": "../../dist/storybook/beeq",
        "config-dir": ".storybook",
        "output-dir": "../../dist/storybook/beeq"
      },
      "configurations": {
        "ci": {
          "args": ["--quiet"]
        }
      }
    },
    "storybook-start-css": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "projects": "beeq-tailwindcss", "target": "build" }],
      "outputs": ["{projectRoot}/.storybook/assets/css/stories.css"],
      "continuous": true,
      "readyWhen": { "logMatches": "Watching BEEQ sources" },
      "inputs": ["default", "{workspaceRoot}/tailwind.config.ts", "{workspaceRoot}/postcss.config.js"],
      "options": {
        "command": "node packages/beeq/scripts/build-styles.mjs --storybook --watch"
      }
    },
    "storybook-build-css": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/.storybook/assets/css/stories.css"],
      "inputs": ["default", "{workspaceRoot}/tailwind.config.ts", "{workspaceRoot}/postcss.config.js"],
      "options": {
        "command": "node packages/beeq/scripts/build-styles.mjs --storybook --minify"
      }
    },
    "icons": {
      "executor": "../../tools:icons",
      "outputs": ["{options.extractToPath}"],
      "options": {
        "assetsFolder": "assets",
        "downloadPath": "tmp",
        "extractToPath": "packages/beeq/src/components/icon/svg",
        "sourceUrl": "https://github.com/phosphor-icons/core",
        "sourceChecksum": "sha256-e108846ce4e8235e6327451769c16cea1f2d15d4ee9b739d6434444ce6f712b4",
        "sourceRef": "2b75f3ad12b420c9504ef05df8d2564a28f8500e",
        "sourceRefType": "commit"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "target": "build", "projects": "beeq-tailwindcss" }],
      "inputs": ["default", "^default", "{workspaceRoot}/tailwind.config.ts", "{workspaceRoot}/postcss.config.js"],
      "options": {
        "command": "pnpm exec vitest run --project spec --coverage",
        "cwd": "packages/beeq"
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "inputs": ["default", "^production", "{workspaceRoot}/tailwind.config.ts", "{workspaceRoot}/postcss.config.js"],
      "options": {
        "command": "pnpm exec vitest run --project e2e",
        "cwd": "packages/beeq"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "target": "stylelint" }],
      "options": {
        "command": "pnpm exec biome check {projectRoot} --max-diagnostics=none"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec biome format {projectRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "target": "stylelint" }],
      "options": {
        "command": "pnpm exec biome lint {projectRoot}"
      }
    },
    "stylelint": {
      "executor": "nx-stylelint:lint",
      "outputs": ["{options.outputFile}"],
      "dependsOn": [{ "target": "build", "projects": "beeq-tailwindcss" }],
      "options": {
        "lintFilePatterns": ["{projectRoot}/**/*.css", "{projectRoot}/**/*.scss"],
        "configFile": "packages/beeq/.stylelintrc.json",
        "ignorePath": ".gitignore"
      }
    },
    "stylelint-strict": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec stylelint \"src/**/*.{css,scss}\" --config .stylelintrc.strict.json",
        "cwd": "packages/beeq"
      }
    },
    "prepare-storybook": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/src/__storybook__/CHANGELOG.md"],
      "inputs": ["default", "{workspaceRoot}/CHANGELOG.md"],
      "options": {
        "command": "cp CHANGELOG.md {projectRoot}/src/__storybook__"
      }
    }
  }
}
